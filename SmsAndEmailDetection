    "# Temizlik fonksiyonu\n",
    "def preprocess_sms(text):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r\"http\\S+|www\\S+|https\\S+\", '', text)\n",
    "    text = re.sub(r'\\@\\w+|\\#', '', text)\n",
    "    text = re.sub(r'[^A-Za-z0-9\\s]', '', text)\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "    return text\n",
    "\n",
    "# Temizlenmiş mesajları yeni sütuna ekle\n",
    "sms_data['clean_message'] = sms_data['message'].apply(preprocess_sms)\n",
    "\n",
    "# İlk 5 temiz mesajı görelim\n",
    "sms_data[['label', 'clean_message']].head()"
   ]
