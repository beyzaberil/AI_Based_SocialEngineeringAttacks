    "# SMS Pipeline: TF-IDF + Random Forest\n",
    "pipeline_sms = Pipeline([\n",
    "    ('tfidf', TfidfVectorizer(max_features=3000)),\n",
    "    ('rf', RandomForestClassifier(n_estimators=100, random_state=42))\n",
    "])\n",
    "\n",
    "# Eğitimi yap\n",
    "pipeline_sms.fit(X_train_sms, y_train_sms)\n",
    "\n",
    "# Tahmin yap\n",
    "y_pred_sms = pipeline_sms.predict(X_test_sms)\n",
    "\n",
    "# Performans değerlendirme\n",
    "print(\"Confusion Matrix (SMS):\\n\", confusion_matrix(y_test_sms, y_pred_sms))\n",
    "print(\"\\nClassification Report (SMS):\\n\", classification_report(y_test_sms, y_pred_sms))"
